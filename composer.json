{
    "name": "flexatech/flexa-seo-aeo",
    "description": "Flexa SEO – AI SEO & Answer Engine Optimization for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL v2 or later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^9.0",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Flexa\\SeoAeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flexa\\SeoAeo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=3G",
        "test": "phpunit",
        "compat:robots": "php tests/Compat/run-robots.php"
    }
}
