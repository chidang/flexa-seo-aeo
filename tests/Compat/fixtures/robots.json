{
	"fixture_version": 1,
	"subject": "Effective robots directives on one published post, Flexa SEO - AEO active alongside each competitor in turn",
	"page": "single published post, no per-post SEO fields set unless the configuration says so",
	"configurations": {
		"default": {
			"description": "Both plugins at default settings, no setup wizard run, Titles & Metas on in Flexa",
			"post_meta": {}
		},
		"post-noindex": {
			"description": "As default, with the post set to noindex in Flexa's metabox",
			"post_meta": {
				"_flexa_seo_aeo_noindex": "1"
			}
		}
	},
	"assertions": {
		"default": {
			"tag_count": 1,
			"must_include": [ "index", "follow" ],
			"must_not_include": [ "noindex", "nofollow" ]
		},
		"post-noindex": {
			"tag_count": 1,
			"must_include": [ "noindex" ],
			"must_not_include": [ "index" ]
		}
	},
