{
    "name": "flexa-seo-aeo",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@9.12.0",
    "scripts": {
        "dev": "vite -c apps/admin/vite.config.ts",
        "build": "tsc -p apps/admin/tsconfig.json --noEmit && vite build -c apps/admin/vite.config.ts",
        "preview": "vite preview -c apps/admin/vite.config.ts",
        "type-check": "tsc -p apps/admin/tsconfig.json --noEmit",
        "format": "prettier --write \"apps/**/*.{ts,tsx,css}\"",
        "i18n:pot": "wp i18n make-pot . i18n/languages/_php.pot --slug=flexa-seo-aeo --domain=flexa-seo-aeo --exclude=apps,node_modules,vendor,assets,tools,tests,docs-site && node tools/i18n/extract-js.mjs i18n/languages/_js.pot && msgcat --use-first i18n/languages/_php.pot i18n/languages/_js.pot -o i18n/languages/flexa-seo-aeo.pot && rm -f i18n/languages/_php.pot i18n/languages/_js.pot"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-label": "^2.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-tooltip": "^1.1.4",
        "@tanstack/react-query": "^5.62.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.469.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.5.5",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "^3.4.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^6.0.0"
    },
    "engines": {
        "node": ">=20",
        "pnpm": ">=9"
    }
}
